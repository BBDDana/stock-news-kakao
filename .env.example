# 카카오 디벨로퍼스(https://developers.kakao.com) 앱의 REST API 키
KAKAO_REST_API_KEY=

# REST API 키의 클라이언트 시크릿 (카카오 로그인용, [앱]>[플랫폼 키]>[REST API 키]에서 확인. 기본 활성화되어 있어 토큰 요청 시 필수)
KAKAO_CLIENT_SECRET=

# 카카오 로그인 플랫폼 설정에 등록한 Redirect URI (kakao_auth.py 최초 인증 시 사용)
KAKAO_REDIRECT_URI=http://localhost:8000/oauth

# 카카오 토큰(access/refresh) 저장 위치
KAKAO_TOKEN_PATH=tokens/kakao_token.json

# --- 뉴스 수집 ---
# 쉼표로 여러 RSS 소스 지정 가능
RSS_URLS=https://www.hankyung.com/feed/finance,https://www.yna.co.kr/rss/economy.xml
# 한 번에 보낼 뉴스 개수
NEWS_COUNT=5
# 제목에 이 키워드 중 하나라도 포함된 뉴스만 발송 (비워두면 전체 발송). 예: 삼성전자,반도체,금리
KEYWORDS=
# 제목 유사도가 이 값 이상이면 같은 뉴스로 간주해 중복 제거 (0~1, 기본 0.6)
DEDUP_SIMILARITY=0.6

# --- 관심종목 시세 ---
# 카테고리별로 묶어서 보내려면 watchlist.json 파일을 사용 (WATCHLIST_PATH로 위치 변경 가능, 기본값: 프로젝트 루트의 watchlist.json)
WATCHLIST_PATH=watchlist.json
# watchlist.json이 없을 때만 사용되는 단일 그룹 형식(종목코드:이름, 쉼표 구분). 예: 005930:삼성전자,035420:NAVER
WATCHLIST=

# --- 지수 요약 ---
SEND_MARKET_SUMMARY=true

# --- AI 한줄 요약 (선택) ---
# true로 켜려면 `pip install -r requirements-ai.txt` 필요
USE_AI_SUMMARY=false
ANTHROPIC_API_KEY=
AI_SUMMARY_MODEL=claude-haiku-4-5-20251001

# --- 카카오 메시지 템플릿 ---
# true: 뉴스 최대 3건을 클릭 가능한 카드(list)로, 나머지 정보는 텍스트로 전송
USE_LIST_TEMPLATE=true

# --- 재시도 / 로깅 ---
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2
LOG_PATH=logs/app.log

# --- HTML 프리뷰 리포트 ---
SAVE_HTML_REPORT=true
REPORTS_DIR=reports
